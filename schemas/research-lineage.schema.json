{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mj3b/trust-autonomy-evidence/schemas/research-lineage.schema.json",
  "title": "Research lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lineage_id", "description", "agents", "activities", "entities", "relations"],
  "properties": {
    "version": {"enum": ["0.5.0", "0.14.0"]},
    "lineage_id": {"enum": ["TAE-LINEAGE-V0.5.0", "TAE-LINEAGE-V0.14.0"]},
    "description": {"type": "string", "minLength": 1},
    "agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agent"}},
    "activities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/activity"}},
    "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "name", "agent_type", "responsibility"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^AGENT-[A-Z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "agent_type": {"enum": ["person", "software"]},
        "responsibility": {"type": "string", "minLength": 1}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_id", "activity_type", "description", "date", "responsible_agent", "assisting_agents", "protocol", "status"],
      "properties": {
        "activity_id": {"type": "string", "pattern": "^ACT-[A-Z0-9-]+$"},
        "activity_type": {"enum": ["question_freeze", "search", "screening", "source_review", "assessment", "validation", "figure_generation", "claim_drafting", "integrity_audit", "release"]},
        "description": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "responsible_agent": {"type": "string", "pattern": "^AGENT-[A-Z0-9-]+$"},
        "assisting_agents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AGENT-[A-Z0-9-]+$"}},
        "protocol": {"type": ["string", "null"]},
        "status": {"enum": ["completed", "open", "blocked"]}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "entity_type", "path", "version", "integrity_state"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^ENTITY-[A-Z0-9-]+$"},
        "entity_type": {"enum": ["question", "source_collection", "selection_record", "source_manifest", "case_packet", "assessment", "validation_result", "figure_data", "figure", "claim_map", "manuscript", "audit_result", "release_manifest"]},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "integrity_state": {"enum": ["verified", "release_manifest", "remote_only", "pending"]}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "relation"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relation": {"enum": ["used", "generated", "derived_from", "attributed_to", "informed", "validated", "blocked_by", "included_in"]}
      }
    }
  }
}
