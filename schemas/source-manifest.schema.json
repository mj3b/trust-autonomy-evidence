{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mj3b/trust-autonomy-evidence/schemas/source-manifest.schema.json",
  "title": "Trust, Autonomy, and Evidence public-case source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "case_id",
    "retrieval_date",
    "evidence_cutoff",
    "rights_statement",
    "sources",
    "unavailable_evidence"
  ],
  "properties": {
    "version": {"const": "0.3.0"},
    "case_id": {"type": "string", "pattern": "^TAE-PUB-[0-9]{3}$"},
    "retrieval_date": {"type": "string", "format": "date"},
    "evidence_cutoff": {"const": "2026-08-06T23:59:59Z"},
    "rights_statement": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/source"}
    },
    "unavailable_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/unavailable"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "issuer",
        "authors",
        "publication_date",
        "retrieval_date",
        "url",
        "archive_url",
        "source_class",
        "availability",
        "provenance_use",
        "preservation",
        "notes"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[OTF][0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "publication_date": {"type": ["string", "null"]},
        "retrieval_date": {"type": "string", "format": "date"},
        "url": {"type": "string", "format": "uri"},
        "archive_url": {"type": ["string", "null"], "format": "uri"},
        "source_class": {
          "enum": [
            "candidate_collection",
            "primary_interview",
            "official_record",
            "official_research",
            "independent_research",
            "independent_reporting",
            "definition"
          ]
        },
        "availability": {"enum": ["available", "partial", "paywalled", "removed"]},
        "provenance_use": {"enum": ["direct_record", "source_claim"]},
        "preservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "file", "sha256"],
          "properties": {
            "status": {"enum": ["remote_only", "locally_hashed_not_redistributed", "included_in_packet"]},
            "file": {"type": ["string", "null"]},
            "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "notes": {"type": "string"}
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "search_record", "effect"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "search_record": {"type": "string", "minLength": 1},
        "effect": {"type": "string", "minLength": 1}
      }
    }
  }
}
