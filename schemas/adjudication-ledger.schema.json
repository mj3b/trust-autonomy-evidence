{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mj3b/trust-autonomy-evidence/schemas/adjudication-ledger.schema.json",
  "title": "Trust, Autonomy, and Evidence adjudication ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "case_id",
    "adjudication_date",
    "frozen_assessment",
    "adjudication_protocol",
    "source_packet",
    "reassessed_fields",
    "carried_forward_sections",
    "dependency_decision",
    "assessor"
  ],
  "properties": {
    "version": {"const": "0.6.0"},
    "case_id": {"const": "TAE-PUB-001"},
    "adjudication_date": {"type": "string", "format": "date"},
    "frozen_assessment": {"$ref": "#/$defs/artifact"},
    "adjudication_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "freeze_commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "freeze_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "source_packet": {"$ref": "#/$defs/artifact"},
    "reassessed_fields": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["json_pointer", "prior_state", "current_state", "evidence_refs", "located_evidence", "material_gap", "decision"],
        "properties": {
          "json_pointer": {"type": "string", "pattern": "^/practical_control/(access|comprehension|authority|feasibility|exercise|effect)/state$"},
          "prior_state": {"const": "supported"},
          "current_state": {"const": "partially_supported"},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^O[0-9]+$"}
          },
          "located_evidence": {"type": "string", "minLength": 1},
          "material_gap": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1}
        }
      }
    },
    "carried_forward_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["autonomy", "trust_evidence", "practical_control.correction", "practical_control.repair", "practical_control.reform"]}
    },
    "dependency_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practical_force_eligible", "paper_blocker_state", "reason"],
      "properties": {
        "practical_force_eligible": {"const": false},
        "paper_blocker_state": {"const": "resolved_by_reclassification"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "orcid", "ai_assistance", "independent_assessment"],
      "properties": {
        "name": {"const": "Mark Julius Banasihan"},
        "orcid": {"const": "0009-0001-8121-2878"},
        "ai_assistance": {"const": true},
        "independent_assessment": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
